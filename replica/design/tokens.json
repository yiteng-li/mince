{
  "_about": "Light-mode tokens for mince. Roles from the recon component list, not measured from Cronometer screenshots (none were captured). accent/plus/macro hues are neutral placeholders; replica-brand changes values, never names. Dark mode: tokens.dark.json. Swift: mince/Utilities/Theme.swift mirrors both. Check: python3 contrast.py tokens.json",
  "color": {
    "bg": "#f2f3f5",
    "surface": "#ffffff",
    "track": "#e6e8ec",
    "border": "#e3e6ea",
    "border-input": "#7d8590",
    "text": "#14171c",
    "text-muted": "#5b6470",
    "accent": "#2f5bea",
    "on-accent": "#ffffff",
    "danger": "#c62f2f",
    "success": "#1f7a4d",
    "warning": "#8a5a00",
    "plus": "#f2c14e",
    "on-plus": "#3a2a00",
    "energy": "#2f5bea",
    "protein": "#1f8a5b",
    "carbs": "#2f6fd6",
    "fat": "#c2410c"
  },
  "pairs": [
    ["text", "bg"], ["text", "surface"],
    ["text-muted", "bg"], ["text-muted", "surface"],
    ["on-accent", "accent"], ["accent", "surface"], ["accent", "bg"],
    ["danger", "surface"], ["success", "surface"], ["warning", "surface"],
    ["on-plus", "plus"],
    ["border-input", "surface", "ui"],
    ["energy", "track", "ui"], ["protein", "surface", "ui"], ["carbs", "surface", "ui"], ["fat", "surface", "ui"],
    ["accent", "surface", "ui"]
  ],
  "font": {
    "sans": "system (SF Pro via Font.system / Dynamic Type)",
    "numbers": "system with .monospacedDigit() for every nutrient value"
  },
  "type": {
    "_note": "iOS Dynamic Type text styles; sizes are the Large (default) setting and scale with the user's text size",
    "caption":  {"style": "caption",     "size": 12, "line": 16, "weight": 400},
    "footnote": {"style": "footnote",    "size": 13, "line": 18, "weight": 400},
    "label":    {"style": "subheadline", "size": 15, "line": 20, "weight": 500},
    "body":     {"style": "body",        "size": 17, "line": 22, "weight": 400},
    "heading":  {"style": "headline",    "size": 17, "line": 22, "weight": 600},
    "title":    {"style": "title3",      "size": 20, "line": 25, "weight": 600},
    "metric":   {"style": "title",       "size": 28, "line": 34, "weight": 700},
    "display":  {"style": "largeTitle",  "size": 34, "line": 41, "weight": 700}
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48],
  "radius": {"sm": 6, "md": 10, "lg": 16, "pill": 999},
  "shadow": {
    "card": {"color": "#101828", "opacity": 0.08, "radius": 3, "y": 1},
    "pop":  {"color": "#101828", "opacity": 0.16, "radius": 16, "y": 8}
  },
  "motion": {"fast": 0.12, "base": 0.2, "spring": "snappy"},
  "layout": {
    "screen-padding": 16, "row-min-height": 44, "tap-target": 44,
    "bar-height": 8, "ring-size": 160, "ring-line": 14, "max-readable-width": 640
  }
}
