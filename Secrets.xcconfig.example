// Copy this file to Secrets.xcconfig (same folder) and fill in your real values.
// Secrets.xcconfig is gitignored — never commit it.
//
// Wiring into Xcode (one-time, see README "Supabase setup"):
//   1. Project > Info > Configurations: set both Debug and Release to use Secrets.xcconfig
//   2. Target > Info > Custom iOS Target Properties: add
//        SUPABASE_URL      = $(SUPABASE_URL)
//        SUPABASE_ANON_KEY = $(SUPABASE_ANON_KEY)
//   3. SupabaseService reads those two Info.plist keys at runtime.

SUPABASE_URL = https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = your-anon-key-here
