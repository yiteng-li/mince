# Edge Function secrets. Set them with:  supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase automatically.)

# Claude API key from console.anthropic.com (used by photo-log, voice-parse, recipe-import, coach)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
CLAUDE_MODEL=

# App Store Connect > Users and Access > Integrations > In-App Purchase key
APPSTORE_ISSUER_ID=
APPSTORE_KEY_ID=
# Contents of the .p8 file, newlines allowed
APPSTORE_PRIVATE_KEY=
APPSTORE_BUNDLE_ID=yell0.mince

# Dev projects only: accept purchases made with Xcode's local StoreKit config (Products.storekit). Never set in production.
ALLOW_XCODE_STOREKIT=false
